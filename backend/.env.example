# Astraeus backend environment variables
# Copy to .env and fill in values before running.
# NEVER commit .env to version control.

# NASA Open APIs - get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# DuckDB file path (use forward slashes on Windows)
# Docker: /data/astraeus.duckdb  (mounted from persistent volume)
# Local:  /absolute/path/to/astraeus.duckdb
DB_PATH=/data/astraeus.duckdb

# Address to bind the HTTP server
BIND_ADDR=0.0.0.0:3000

# Rust log level (trace, debug, info, warn, error)
RUST_LOG=info

# ML inference service base URL
# Docker:  http://ml:8000   (Docker service name)
# Local:   http://localhost:8000
ML_SERVICE_URL=http://ml:8000

# JWT signing secret - generate with: openssl rand -hex 32
# Must be at least 32 characters; 64-char hex recommended
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Resend email delivery - get a key at https://resend.com/
RESEND_API_KEY=re_YOUR_API_KEY_HERE
# From address - use onboarding@resend.dev until your domain is verified in Resend
RESEND_FROM=Astraeus <onboarding@resend.dev>

# Public frontend base URL - used in email links and as the default OAuth
# redirect base. Local: http://localhost:5173   Prod: https://astraeusio.com
APP_URL=https://astraeusio.com

# ── Social login (OAuth) ──────────────────────────────────────────────────────
# Each provider is OPTIONAL - leave a client id/secret blank to disable it (its
# button is hidden). Register the apps with these callback URLs:
#   GitHub:  {APP_URL}/auth/oauth/github/callback
#   Google:  {APP_URL}/auth/oauth/google/callback
# GitHub OAuth App:  https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth 2.0 Web client:  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if the backend's public origin differs from APP_URL
# (e.g. separate api. subdomain). Defaults to APP_URL.
# OAUTH_REDIRECT_BASE=https://astraeusio.com

# Timeouts and retry (seconds / count)
# HTTP_TIMEOUT is the reqwest client ceiling. A single retry attempt is bounded
# by min(HTTP_TIMEOUT, max(2s, that source's poll interval)), so a fast poller
# is never held for the full client timeout.
HTTP_TIMEOUT=60
ML_TIMEOUT=5
# Total attempts per poll including the first, clamped to 1..=5. 1 means no
# retry. Only transient failures are retried; a 404 or a decode error is not.
RETRY_COUNT=3

# Poller intervals in seconds (omit to use defaults)
ISS_INTERVAL=5
KP_INTERVAL=60
KP_3H_INTERVAL=1800
SOLAR_WIND_INTERVAL=60
XRAY_INTERVAL=120
ALERTS_INTERVAL=300
NEO_INTERVAL=1800
EPIC_INTERVAL=1800
APOD_INTERVAL=3600
EXOPLANET_INTERVAL=86400
IMF_INTERVAL=60
DST_INTERVAL=300
STARLINK_INTERVAL=3600
ANOMALY_INTERVAL=60

# Lets a signed in account change its own plan tier. Off unless set to 1 or
# true. There is no payment processor, so nothing can tell a paid tier from an
# unpaid one; leave this unset in production and change tiers out of band.
# When billing is connected this variable goes and the payment webhook becomes
# the only thing that may raise a tier.
ALLOW_SELF_SERVE_PLAN_CHANGE=

# LOSING THIS KEY PERMANENTLY DESTROYS EVERY ENROLLED SECOND FACTOR AND FORCES
# EVERY 2FA USER TO RE-ENROL, AND UNTIL AN OPERATOR CLEARS totp_enabled AND
# totp_secret_enc FOR THEM THEY CANNOT SIGN IN AT ALL. Back it up separately
# from the database, because a backup holding both is worth nothing.
#
# Encrypts TOTP secrets at rest. Must be 32 bytes as 64 hex characters and must
# not be the same value as JWT_SECRET; the backend refuses to start if it is.
# Generate with: openssl rand -hex 32
#
# Leaving it unset is allowed only while no account has 2FA enabled. In that
# state the backend starts with a warning and refuses 2FA setup. Once any
# account is enrolled, starting without the key, or with the wrong key, is a
# hard failure by design. Recovery procedure: docs/RUNBOOK.md
TOTP_ENCRYPTION_KEY=
